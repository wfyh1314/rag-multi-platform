# ========== Application ==========
APP_NAME=enterprise_multi_tenant_rag
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# JWT auth (set AUTH_SKIP=true in dev to bypass)
JWT_SECRET_KEY=change-me-in-production-use-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
AUTH_SKIP=true

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ========== MySQL ==========
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=rag_user
MYSQL_PASSWORD=rag_password
MYSQL_DATABASE=rag_multi_tenant
MYSQL_CHARSET=utf8mb4

# ========== Redis ==========
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ========== Qdrant ==========
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=tenant_

# ========== Celery ==========
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ========== 阿里通义 DashScope ==========
DASHSCOPE_API_KEY=your-dashscope-key
ALI_TONGYI_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ALI_TONGYI_MAX_MODEL=qwen3-max
TONGYI_EMBEDDING_MODEL=text-embedding-v1
EMBEDDING_DIMENSION=1536
RERANK_MODEL=gte-rerank-v2
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096

# ========== 文档分块 ==========
# 每个 chunk 的最大字符数
CHUNK_SIZE=1000

# 相邻 chunk 之间的重叠字符数，有助于保留跨 chunk 的上下文
CHUNK_OVERLAP=150

# ========== File storage ==========
UPLOAD_DIR=tmp/uploads
MAX_UPLOAD_SIZE_MB=50

# ========== MinerU (PDF parsing, optional) ==========
MINERU_API_URL=
MINERU_API_KEY=
